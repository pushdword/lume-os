set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_C_COMPILER_TARGET x86_64-unknown-none-elf)
set(CMAKE_CXX_COMPILER_TARGET x86_64-unknown-none-elf)
set(CMAKE_ASM_COMPILER_TARGET x86_64-unknown-none-elf)
set(CMAKE_C_FLAGS_INIT "-march=x86-64 -mno-red-zone -ftls-model=local-exec -ffunction-sections -fdata-sections -fno-pic -fno-stack-protector -D__lume__=1")
set(CMAKE_CXX_FLAGS_INIT "-march=x86-64 -mno-red-zone -ftls-model=local-exec -ffunction-sections -fdata-sections -fno-pic -fno-stack-protector -fno-exceptions -fno-rtti -D__lume__=1 -D_LIBCPP_DISABLE_VISIBILITY_ANNOTATIONS")
set(CMAKE_C_FLAGS_RELEASE "-Oz -DNDEBUG")
set(CMAKE_CXX_FLAGS_RELEASE "-Oz -DNDEBUG")
