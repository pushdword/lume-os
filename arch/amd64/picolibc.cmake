set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_ASM_FLAGS_INIT "--target=x86_64-unknown-none-elf -march=x86-64 -mno-red-zone")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_C_FLAGS_INIT "--target=x86_64-unknown-none-elf -march=x86-64 -mno-red-zone -ftls-model=local-exec -fno-stack-protector -fhosted -fno-builtin -fno-pic -fno-pie -fno-unwind-tables -fno-asynchronous-unwind-tables")
set(__THREAD_LOCAL_STORAGE ON CACHE BOOL "TLS" FORCE)
set(__GLOBAL_ERRNO OFF CACHE BOOL "Global errno" FORCE)
set(__SINGLE_THREAD OFF CACHE BOOL "Single execution context" FORCE)
set(__ATOMIC_UNGETC OFF CACHE BOOL "Atomic ungetc")
set(__IO_LONG_LONG ON CACHE BOOL "64-bit stdio")
set(__MB_CAPABLE ON CACHE BOOL "Multibyte characters" FORCE)
set(__MB_EXTENDED_CHARSETS_ISO ON CACHE BOOL "ISO character sets" FORCE)
set(TESTS OFF CACHE BOOL "Picolibc tests")
