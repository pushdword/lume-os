.DEFAULT_GOAL := all
CSTD := gnu23
PORT := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
SOURCE = $(OS_ROOT)/vendor/diffutils
include $(PORT)/../standalone.mk
CPPFLAGS += -DHAVE_CONFIG_H -D_GNU_SOURCE '-I$(OS_ROOT)/ports/diffutils/generated/lib' '-I$(OS_ROOT)/ports/diffutils/generated' '-I$(OS_ROOT)/vendor/diffutils/lib' '-I$(OS_ROOT)/ports/diffutils' '-I$(OS_ROOT)/ports/standalone/include' '-I$(KERNEL)/include/abi/native' '-I$(OS_ROOT)/vendor/diffutils/src' '-I$(OS_ROOT)/vendor/diffutils' -include '$(OS_ROOT)/ports/diffutils/compat.h'
SOURCES := lib/allocator.c lib/argmatch.c lib/basename-lgpl.c lib/basename.c lib/binary-io.c lib/bitrotate.c lib/btoc32.c lib/btowc.c lib/c-ctype.c lib/c-file-type.c lib/c-stack.c lib/c-strcasecmp.c lib/c32_apply_type_test.c lib/c32_get_type_test.c lib/c32isalnum.c lib/c32isalpha.c lib/c32isblank.c lib/c32iscntrl.c lib/c32isdigit.c lib/c32isgraph.c lib/c32islower.c lib/c32isprint.c lib/c32ispunct.c lib/c32isspace.c lib/c32isupper.c lib/c32isxdigit.c lib/c32tolower.c lib/c32width.c lib/calloc.c lib/careadlinkat.c lib/chdir-long.c lib/cloexec.c lib/close.c lib/closedir.c lib/cmpbuf.c lib/diagnose.c lib/dirfd.c lib/dirname-lgpl.c lib/dirname.c lib/dup.c lib/dup2.c lib/error.c lib/exclude.c lib/exitfail.c lib/fchdir.c lib/fcntl.c lib/fd-hook.c lib/fdopendir.c lib/filenamecat-lgpl.c lib/filenamecat.c lib/fnmatch.c lib/fopen.c lib/free.c lib/fstat.c lib/fstatat.c lib/getcwd-lgpl.c lib/getdtablesize.c lib/getopt.c lib/getopt1.c lib/getprogname.c lib/getrandom.c lib/gettime.c lib/glthread/lock.c lib/glthread/once.c lib/glthread/threadlib.c lib/hard-locale.c lib/hash.c lib/ialloc.c lib/localcharset.c lib/localeconv.c lib/lstat.c lib/malloc.c lib/malloc/dynarray_at_failure.c lib/malloc/dynarray_emplace_enlarge.c lib/malloc/dynarray_finalize.c lib/malloc/dynarray_resize.c lib/malloc/dynarray_resize_clear.c lib/malloca.c lib/mbrtoc32.c lib/mbrtowc.c lib/mbscasecmp.c lib/mbsrtoc32s-state.c lib/mbsrtoc32s.c lib/mbsrtowcs-state.c lib/mbsrtowcs.c lib/mbszero.c lib/mcel.c lib/memchr.c lib/mkdir.c lib/mkstemp.c lib/mktime.c lib/nl_langinfo.c lib/nstrftime.c lib/open.c lib/openat-die.c lib/openat-proc.c lib/openat.c lib/opendir.c lib/popen.c lib/progname.c lib/propername-lite.c lib/quotearg.c lib/readlink.c lib/readlinkat.c lib/realloc.c lib/reallocarray.c lib/regex.c lib/same-inode.c lib/save-cwd.c lib/setenv.c lib/setlocale-lock.c lib/setlocale_null-unlocked.c lib/setlocale_null.c lib/sh-quote.c lib/sig-handler.c lib/sigsegv.c lib/stackvma.c lib/stat-time.c lib/stat.c lib/stdbit.c lib/stdc_bit_width.c lib/stdc_leading_zeros.c lib/stdlib.c lib/stdopen.c lib/strerror-override.c lib/strerror.c lib/stripslash.c lib/strnlen1.c lib/strtoll.c lib/system-quote.c lib/tempname.c lib/time_rz.c lib/timegm.c lib/timespec.c lib/timespec_get.c lib/unicase/tolower.c lib/unictype/ctype_alnum.c lib/unictype/ctype_alpha.c lib/unictype/ctype_blank.c lib/unictype/ctype_cntrl.c lib/unictype/ctype_digit.c lib/unictype/ctype_graph.c lib/unictype/ctype_lower.c lib/unictype/ctype_print.c lib/unictype/ctype_punct.c lib/unictype/ctype_space.c lib/unictype/ctype_upper.c lib/unictype/ctype_xdigit.c lib/unistd.c lib/unistr/u32-chr.c lib/unistr/u32-cpy.c lib/unistr/u32-pcpy.c lib/unistr/u32-strcat.c lib/unistr/u32-strlen.c lib/uniwidth/width.c lib/unsetenv.c lib/version-etc-fsf.c lib/version-etc.c lib/wctype-h.c lib/wcwidth.c lib/xalloc-die.c lib/xfreopen.c lib/xmalloc.c lib/xmalloca.c lib/xstdopen.c lib/xstrtoimax.c lib/xstrtol.c lib/xstrtoul.c shared/signals.c shared/file_mode.c shared/resource.c shared/optional.c shared/sleep.c shared/realpath.c shared/limits.c shared/process.c shared/stream_pipe.c
OBJECTS := $(addprefix $(OUT)/obj/,$(addsuffix .o,$(basename $(SOURCES))))
.PHONY: all
all: $(OUT)/libdiffutils.a $(OUT)/diff $(OUT)/diff3 $(OUT)/sdiff
$(OUT)/libdiffutils.a: $(OBJECTS)
	rm -f $@
	$(AR) rcs $@ $^
$(OUT)/diff: $(OUT)/obj/src/analyze.o $(OUT)/obj/src/context.o $(OUT)/obj/src/diff.o $(OUT)/obj/src/dir.o $(OUT)/obj/src/ed.o $(OUT)/obj/src/ifdef.o $(OUT)/obj/src/io.o $(OUT)/obj/src/normal.o $(OUT)/obj/src/side.o $(OUT)/obj/src/system.o $(OUT)/obj/src/util.o $(OUT)/libdiffutils.a
	$(LD) $(LDFLAGS) $(RUNTIME) $^ $(LIBS) -o $@
$(OUT)/diff3: $(OUT)/obj/src/diff3.o $(OUT)/obj/src/system.o $(OUT)/libdiffutils.a
	$(LD) $(LDFLAGS) $(RUNTIME) $^ $(LIBS) -o $@
$(OUT)/sdiff: $(OUT)/obj/src/sdiff.o $(OUT)/obj/src/system.o $(OUT)/libdiffutils.a
	$(LD) $(LDFLAGS) $(RUNTIME) $^ $(LIBS) -o $@
