--- a/lib/config.h
+++ b/lib/config.h
@@ -4075,7 +4075,7 @@
 
 /* Define to 1 if open() should work around the inability to open a directory.
    */
-#define REPLACE_OPEN_DIRECTORY 1
+#define REPLACE_OPEN_DIRECTORY 0
 
 /* Define if gnulib uses its own posix_spawn and posix_spawnp functions. */
 #define REPLACE_POSIX_SPAWN 1
--- a/lib/sys/stat.h
+++ b/lib/sys/stat.h
@@ -1374,7 +1374,10 @@
     /* We can't use the object-like #define stat rpl_stat, because of
        struct stat.  This means that rpl_stat will not be used if the user
        does (stat)(a,b).  Oh well.  */
-#   if defined _AIX && defined stat && defined _LARGE_FILES
+#   if defined(__lume__) && defined(LUME_POSIX_STAT64)
+#    undef stat64
+#    define stat64(name, st) rpl_stat (name, st)
+#   elif defined _AIX && defined stat && defined _LARGE_FILES
      /* With _LARGE_FILES defined, AIX (only) defines stat to stat64,
         so we have to replace stat64() instead of stat(). */
 #    undef stat64
--- a/lib/fcntl.h
+++ b/lib/fcntl.h
@@ -960,6 +960,11 @@
 # undef O_SEARCH /* musl mistakenly #defines O_SEARCH to O_PATH.  */
 #endif
 
+#if defined __lume__
+/* The native open modes do not include search-only access.  */
+# undef O_SEARCH
+#endif
+
 #ifndef O_SEARCH
 # define O_SEARCH O_RDONLY /* Often close enough in non-POSIX systems.  */
 #endif
